# ─── Entorno de build (los lee app.config.ts a través de config/build-config.js) ──
# La identidad publicada (nombre, slug, owner, paquete Android, bundle id, esquema y
# dominio de enlaces) vive en config/app-identity.js, no aquí: EAS evalúa la
# configuración SIN cargar este archivo en `eas init`, `eas credentials`, etc.
# Solo para una VARIANTE de build (por ejemplo, un paquete con sufijo .dev) se
# sobrescribe con estas variables; en el uso normal se dejan sin definir.
# APP_ANDROID_PACKAGE="mx.com.sysosa.rescate.dev"
# APP_IOS_BUNDLE_ID="mx.com.sysosa.rescate.dev"
# APP_SCHEME="alakito-dev"
# APP_LINK_DOMAIN="alakito.mx"
# Llave de Maps SDK for Android (Google Cloud, restringida al paquete y su SHA-1).
# Es un secreto de build: en EAS va como variable de entorno del proyecto; aquí
# solo para builds locales. Sin ella la app funciona pero el mapa sale vacío en Android.
GOOGLE_MAPS_ANDROID_API_KEY=""
# Esquema inverso del client ID de iOS de Google (com.googleusercontent.apps.xxx).
# Vacío hasta tener el client ID de iOS; sin él no se configura Google en iOS.
GOOGLE_IOS_URL_SCHEME=""

# ─── Valores públicos en tiempo de ejecución (Expo los inserta en el bundle) ──
# Un archivo .env por perfil de EAS; en local apunta al backend de desarrollo.
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"
# Client ID de tipo Web del proyecto de Google: el ID token de Android se emite
# para esta audiencia. Debe estar en GOOGLE_MOBILE_CLIENT_IDS del backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# Client ID de tipo iOS del mismo proyecto.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
