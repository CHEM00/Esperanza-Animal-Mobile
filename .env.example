# ─── Identidad de la app (tiempo de build; los lee app.config.ts) ────────────
# Paquete Android: el MISMO del TWA publicado en Play (docs/08 §4).
APP_ANDROID_PACKAGE="mx.com.sysosa.rescate"
# Bundle id de iOS: nuevo; debe coincidir con IOS_BUNDLE_ID del backend.
APP_IOS_BUNDLE_ID="mx.com.sysosa.rescate"
# Esquema de URL propio para el retorno de OAuth por navegador. Debe coincidir
# con MOBILE_APP_SCHEME del backend (allí lleva ://).
APP_SCHEME="alakito"
# Dominio de enlaces universales / App Links (sin https://).
APP_LINK_DOMAIN="alakito.mx"
# Id del proyecto en EAS (aparece al ejecutar `eas init`). Vacío hasta entonces.
EAS_PROJECT_ID=""
# Esquema inverso del client ID de iOS de Google (com.googleusercontent.apps.xxx).
# Vacío hasta tener el client ID de iOS; sin él no se configura Google en iOS.
GOOGLE_IOS_URL_SCHEME=""

# ─── Valores públicos en tiempo de ejecución (Expo los inserta en el bundle) ──
# Un archivo .env por perfil de EAS; en local apunta al backend de desarrollo.
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"
# Client ID de tipo Web del proyecto de Google: el ID token de Android se emite
# para esta audiencia. Debe estar en GOOGLE_MOBILE_CLIENT_IDS del backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# Client ID de tipo iOS del mismo proyecto.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
